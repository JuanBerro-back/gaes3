APP_ENV=development
APP_NAME=GAES3 - Gestión Deserciones SENA
APP_DEBUG=true
SECRET_KEY=change_me_in_production_generate_strong_32_plus_chars_min_32
DATABASE_URL=sqlite:///./data/gaes3.db
DB_ECHO=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_BLOCK_MINUTES=15
SESSION_INACTIVITY_MINUTES=10
UPLOADS_DIR=./uploads
MAX_FILE_MB=25
ALLOWED_EXTS=pdf,doc,docx,xls,xlsx,jpg,jpeg,png,heic,mp4
BLOCKED_EXTS=exe,bat,sh,ps1,js,php,py,vbs,scr,com,msi,jar,html,htm,svg
DAYS_REAPERTURA_MAX=90
DAYS_SIN_SEGUIMIENTO_ALERT=7
MIN_ACTUACIONES_PARA_CIERRE=1
FORMATO_NUMERO_CASO=DES-%06d
LOG_LEVEL=INFO
AUDIT_IP_ENABLED=false
EXPORT_BATCH_SIZE=1000
